{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(/opt/gradle/bin/gradle:*)",
      "Bash(scripts/setup-android-sdk.sh)",
      "Bash(./scripts/setup-android-sdk.sh)",
      "Bash(bash scripts/setup-android-sdk.sh)",
      "Bash(scripts/ladder.sh)",
      "Bash(scripts/ladder.sh:*)",
      "Bash(./scripts/ladder.sh)",
      "Bash(./scripts/ladder.sh:*)",
      "Bash(bash scripts/ladder.sh)",
      "Bash(bash scripts/ladder.sh:*)",
      "Bash(scripts/test-ladder-guards.sh)",
      "Bash(./scripts/test-ladder-guards.sh)",
      "Bash(bash scripts/test-ladder-guards.sh)",
      "Bash(scripts/warm-gradle.sh)",
      "Bash(./scripts/warm-gradle.sh)",
      "Bash(bash scripts/warm-gradle.sh)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin main)",
      "Bash(git push -u origin main:*)",
      "Bash(git push -u origin main)",
      "Bash(git push origin +:*)",
      "Bash(git push -u origin +:*)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push -u origin HEAD:main)",
      "Bash(git push -u origin HEAD:main:*)"
    ]
  }
}
